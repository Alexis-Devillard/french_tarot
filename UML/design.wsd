@startuml TarotClassDiag

top to bottom direction
skinparam linetype ortho

' ======== Definition classes =========
object Game
object Board
object Player
object Hand
object Deck
object Card
object TrumpCard
object ColorCard

' ======== Definition liaisons =========
Card "0-78" --* Deck
Card "0-78" --o Hand

Hand "1" --* Player

Deck "1" --* Game
Board "1" --* Game
Player "3-5" --* Game

Card "0-78" --o Board

Card <|-- TrumpCard
Card <|-- ColorCard

' ======== Definition attributs =========
Card : string value
ColorCard : string symbol

Deck : vector<Card> cards

Player : int score
Player : Hand hand

Hand : vector<Card*> cards

Board : vector<Card*> chien

Game : vector<Player> players
Game : Board board
Game : Deck deck
Game : Player* dealer
Game : Player* cutter


@enduml